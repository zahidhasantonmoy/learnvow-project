APP_NAME=LearnVow
APP_ENV=local
APP_KEY=
# EB-02: never ship debug ON in the template a deployer copies for
# production — a 500 would leak stack traces (paths, SQL, config).
# Local dev overrides this to true in its own .env.
APP_DEBUG=false
# EB-03: must match the URL the app is actually served on — emailed
# links, signed URLs and the sitemap are built from this. Local dev
# serves on http://127.0.0.1:8170.
APP_URL=http://127.0.0.1:8170

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 — production only (local disk until then; user adds
# these at production time). Never put real keys in code or chat.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false
BOOKFILES_DISK=bookfiles

VITE_APP_NAME="${APP_NAME}"

# --- Production checklist (EB-05 / EB-11 / SEC-05) ---
# Keys the app reads but this file used to omit. FCM is NOT env-driven:
# it is configured in Super Admin settings (settings.fcm.*) — these two
# keys are documented here only so a deployer knows where to look.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT=
SCOUT_DRIVER=database
SANCTUM_STATEFUL_DOMAINS=
# SEC-05: production over HTTPS MUST set this to true, or the session
# cookie can travel over plain HTTP. LOCAL DEV IS HTTP: if you copy
# this file for local use, set it to false (or leave it unset) or
# logins will break locally.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
BACKUP_ARCHIVE_PASSWORD=
# SESSION_ENCRYPT is above (false locally; set true in production).
#
# Before first production deploy also run:
#   php artisan config:cache && php artisan route:cache
#   php artisan event:cache && php artisan view:cache
# and arrange a queue worker (QUEUE_CONNECTION=database; supervisor or
# systemd) if any notification is ever queued, plus backup credentials
# for the s3 disk in config/backup.php (local disk is the working one
# until AWS/R2 keys are set above).
